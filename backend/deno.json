{
	"nodeModulesDir": "auto",
	"tasks": {
		"dev": "deno run --watch --allow-env --allow-ffi --allow-net --allow-read --allow-run --allow-write src/index.ts",
		"lint": "deno run --allow-env --allow-read --allow-sys npm:eslint .",
